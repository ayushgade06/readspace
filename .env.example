# Copy this file to .env and fill in the values.
# .env is ignored by git. Never commit real credentials.

# --- Application ---
PORT=4000

# --- PostgreSQL ---
# For local development the database runs in Docker and is published
# on host port 5433 (see docker-compose.yml), so DB_HOST is localhost.
# Inside Docker Compose and Kubernetes the app overrides DB_HOST/DB_PORT itself.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=readspace
DB_USER=readspace
DB_PASSWORD=change-me

# --- Grafana admin login (Docker Compose) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Host ports used by Docker Compose ---
# Change these only if the port is already in use on your machine.
APP_PORT=4000
DB_HOST_PORT=5433
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
